#!/usr/bin/env bash
#MISE description="Resumable search: mise run search [DEPTH] [ANY] [extra flags] [--push]. Output goes to runs/d<DEPTH>a<ANY>."
#MISE depends=["build"]
# Re-running the same command continues from the checkpoint in the output directory.
# Extra flags are passed through, e.g.: mise run search 3 0 --min-group 60
# --push (or SEARCH_PUSH=1): when the run completes, commit its directory and push it.
# --commit: commit only.
set -euo pipefail
push="${SEARCH_PUSH:-0}"
commit=0
args=()
for a in "$@"; do
  case "$a" in
    --push) push=1 ;;
    --commit) commit=1 ;;
    *) args+=("$a") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
name="$(scripts/runname.sh "$@")"
depth="${1:-2}"
any="${2:-0}"
if [ "$#" -ge 2 ]; then shift 2; else shift "$#"; fi
out="runs/${name}"
echo "output: ${out}  (log: ${out}/run.log)" >&2
WATCH=1 target/release/webb-toroids --depth "$depth" --any "$any" --out "$out" --resume "$@"
# only a run that reached its "done" line is committed; an interrupted one is left for the next resume
if [ "$push" = 1 ] || [ "$commit" = 1 ]; then
  if grep -q '^done ' "$out/run.log"; then
    n=$(($(wc -l < "$out/results.tsv") - 1))
    git add "$out"
    if git diff --cached --quiet -- "$out"; then echo "nothing new to commit in $out" >&2
    else git commit -q -m "adds $out ($n results)" -- "$out"; echo "committed $out" >&2; fi
    if [ "$push" = 1 ]; then
      branch="$(git rev-parse --abbrev-ref HEAD)"
      git pull --rebase --autostash -q origin "$branch"
      git push -q origin "$branch"
      echo "pushed to origin/$branch" >&2
    fi
  else
    echo "run did not finish; not committing" >&2
  fi
fi
